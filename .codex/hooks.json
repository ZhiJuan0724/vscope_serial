{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "commandWindows": "pwsh -NoLogo -NoProfile -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/session_start.ps1')\"",
            "command": "pwsh -NoLogo -NoProfile -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/session_start.ps1')\"",
            "statusMessage": "Loading VScope project rules",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|shell_command|functions.shell_command",
        "hooks": [
          {
            "type": "command",
            "commandWindows": "pwsh -NoLogo -NoProfile -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/pre_tool_use_policy.ps1')\"",
            "command": "pwsh -NoLogo -NoProfile -Command \"$root = git rev-parse --show-toplevel; & (Join-Path $root '.codex/hooks/pre_tool_use_policy.ps1')\"",
            "statusMessage": "Checking VScope shell policy",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
